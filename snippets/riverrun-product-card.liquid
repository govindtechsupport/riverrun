{% doc %}
  Riverrun product card: beige 3:4 card with even spacing. At rest it shows only the piece
  number (wide-spaced capitals) above the piece. The piece is centred with equal space around
  it and never cropped. On hover or focus the card lifts (lighter, 6px up, soft shadow) and
  the price fades in at the bottom in the same font and style as the number. Out-of-stock
  products show "Sold out" when they have a nonzero price.
  A zero-priced product displays a zero amount with the active currency.
  The price/status is always visible on touch screens.

  @param {product} product - The product to render.
  @param {string} [loading] - Image loading strategy: 'lazy' (default) or 'eager'.
  @example
  {% render 'riverrun-product-card', product: product %}
{% enddoc %}

{%- liquid
  assign card_loading = loading | default: 'lazy'
  assign image = product.featured_image
-%}

<a class="rr-card" href="{{ product.url }}" data-rr-card>
  <span class="rr-card__name">{{ product.title | escape }}</span>
  <span class="rr-card__pics">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 900
        | image_tag:
          alt: image.alt | default: product.title,
          widths: '300, 450, 600, 900',
          sizes: '(max-width: 760px) 45vw, 280px',
          loading: card_loading,
          class: 'rr-card__pic'
      }}
    {%- endif -%}
  </span>
  <span class="rr-card__price">
    {%- if product.price == 0 -%}
      0 {{ cart.currency.iso_code | default: shop.currency }}
    {%- elsif product.available -%}
      {{ product.price | money_without_trailing_zeros }}
    {%- else -%}
      {{ 'products.product.sold_out' | t }}
    {%- endif -%}
  </span>
</a>

{% stylesheet %}
  .rr-card {
    --rr-card-pad: clamp(22px, 2.8vw, 40px);
    --rr-card-pad-inline: clamp(8px, 1vw, 14px);
    --rr-card-lift: #faf6ea;

    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    row-gap: var(--rr-card-pad);
    padding: var(--rr-card-pad) var(--rr-card-pad-inline);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--rr-card);
    color: var(--rr-ink);
    text-decoration: none;
    transition:
      background-color 0.5s cubic-bezier(0.22, 0.61, 0.36, 1),
      transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .rr-card__name,
  .rr-card__price {
    font-family: var(--rr-font-caps);
    -webkit-text-stroke: 0.35px currentColor;
    font-size: clamp(11px, 1.05vw, 15px);
    letter-spacing: 0.22em;
    line-height: 1.2;
    text-align: center;
    text-indent: 0.22em;
    text-transform: uppercase;
  }

  /* The photos are 760 x 650 transparent canvases and the piece fills about 80% of them. The
     canvas is drawn about the full card width (side padding is kept small), centred in the picture
     area, so the piece is about 80% of the card wide with equal space around it. Only transparent padding
     reaches the edge, so the piece is never cropped. */
  .rr-card__pics {
    position: relative;
    display: block;
    min-height: 0;
  }

  .rr-card__pic {
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc((100% + var(--rr-card-pad-inline) * 2) * 1.02);
    max-width: none;
    height: auto;
    filter: drop-shadow(0 12px 12px rgb(40 30 15 / 14%));
    transform: translate(-50%, -50%);
  }

  .rr-card__price {
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  .rr-card:hover,
  .rr-card:focus-visible {
    background: var(--rr-card-lift);
    box-shadow: 0 18px 30px rgb(60 40 10 / 18%);
    transform: translateY(-6px);
  }

  .rr-card:hover .rr-card__price,
  .rr-card:focus-visible .rr-card__price {
    opacity: 1;
    transform: none;
  }

  .rr-card:focus-visible {
    outline: 2px solid var(--rr-ink);
    outline-offset: 3px;
  }

  @media (hover: none) {
    .rr-card__price {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .rr-card {
      --rr-card-pad: 18px;
      --rr-card-pad-inline: 8px;
    }

    .rr-card__name,
    .rr-card__price {
      font-size: 10px;
      letter-spacing: 0.14em;
      text-indent: 0.14em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rr-card,
    .rr-card__price {
      transition: none;
    }

    .rr-card:hover,
    .rr-card:focus-visible {
      transform: none;
    }
  }
{% endstylesheet %}
