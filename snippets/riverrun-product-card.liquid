{% doc %}
  Riverrun product card: beige card, product name in wide-spaced capitals at the top,
  the front-on photo at the bottom (grows 4% on hover) and the price fading in at the
  bottom on hover (always visible on touch screens). Out-of-stock products show "Sold".

  @param {product} product - The product to render.
  @param {string} [loading] - Image loading strategy: 'lazy' (default) or 'eager'.

  @example
  {% render 'riverrun-product-card', product: product %}
{% enddoc %}

{%- liquid
  assign card_loading = loading | default: 'lazy'
  assign image = product.featured_image
-%}

<a class="rr-card" href="{{ product.url }}" data-rr-card>
  <span class="rr-card__name">{{ product.title | escape }}</span>
  {%- if image != blank -%}
    <span class="rr-card__stage">
      {{
        image
        | image_url: width: 900
        | image_tag:
          alt: image.alt | default: product.title,
          widths: '300, 450, 600, 900',
          sizes: '(max-width: 760px) 45vw, 280px',
          loading: card_loading,
          class: 'rr-card__pic'
      }}
    </span>
  {%- endif -%}
  <span class="rr-card__price">
    {%- if product.tags contains 'enquire' -%}
      {{ settings.riverrun_enquire_label | default: 'enquire' }}
    {%- elsif product.available -%}
      {{ product.price | money_without_trailing_zeros }}
    {%- else -%}
      {{ 'products.product.sold_out' | t }}
    {%- endif -%}
  </span>
</a>

{% stylesheet %}
  .rr-card {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--rr-card);
    color: var(--rr-ink);
    text-decoration: none;
  }

  .rr-card__name {
    position: absolute;
    top: 19%;
    right: 0;
    left: 0;
    padding-inline: 8px;
    font-family: var(--rr-font-caps);
    font-size: clamp(11px, 1.05vw, 15px);
    letter-spacing: 0.22em;
    text-indent: 0.22em;
    text-align: center;
    text-transform: uppercase;
  }

  /* The photos are 3:2 canvases with transparent padding, so the picture is drawn wider than
     the card (the card clips it) to make the piece itself about 70% of the card width.
     It rests near the bottom, under the name. */
  .rr-card__stage {
    position: absolute;
    right: 0;
    bottom: 14%;
    left: 0;
    display: block;
    pointer-events: none;
  }

  .rr-card__pic {
    display: block;
    width: 122%;
    max-width: none;
    height: auto;
    margin-inline: -11%;
    filter: drop-shadow(0 12px 12px rgb(40 30 15 / 14%));
    transform-origin: 50% 82%;
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .rr-card:hover .rr-card__pic,
  .rr-card:focus-visible .rr-card__pic {
    transform: scale(1.12);
  }

  .rr-card__price {
    position: absolute;
    right: 0;
    bottom: 5%;
    left: 0;
    font-family: var(--rr-font-body);
    font-size: 13px;
    font-style: italic;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  .rr-card:hover .rr-card__price,
  .rr-card:focus-visible .rr-card__price {
    opacity: 1;
    transform: none;
  }

  .rr-card:focus-visible {
    outline: 2px solid var(--rr-ink);
    outline-offset: 3px;
  }

  @media (hover: none) {
    .rr-card__price {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .rr-card__name {
      font-size: 10px;
      letter-spacing: 0.14em;
      text-indent: 0.14em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rr-card__pic,
    .rr-card__price {
      transition: none;
    }
  }
{% endstylesheet %}
