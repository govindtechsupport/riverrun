{% comment %}
  Section contract.
  Riverrun header: a fixed dark bar (84px, 94% opaque, blurred) with the gold logo on the
  left and the main menu on the right. Its edges line up with the 1182px product grid.
  On the home page it stays hidden until the opening logo has scrolled out of view
  (a `#rr-opening` element is present); on every other page it is always visible.
  The logo fades out when the footer logo (`[data-rr-footer-logo]`) comes into view.
  @example
  <!-- Lives in sections/header-group.json -->
{% endcomment %}

{%- liquid
  assign menu = section.settings.menu
  assign show_account = section.settings.show_account
  assign show_cart = section.settings.show_cart
-%}

<rr-header class="rr-header" data-rr-header>
  <div class="rr-header__bar">
    <a class="rr-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag: alt: shop.name, width: 200, loading: 'eager', class: 'rr-header__logo-img'
        }}
      {%- else -%}
        <img
          class="rr-header__logo-img"
          src="{{ 'riverrun-logo-gold.png' | asset_url }}"
          alt="{{ shop.name | escape }}"
          width="180"
          height="34"
        >
      {%- endif -%}
    </a>

    {%- if menu != blank -%}
      <nav class="rr-header__nav" aria-label="{{ 'accessibility.menu' | t }}">
        <ul class="rr-header__list">
          {%- for link in menu.links -%}
            <li>
              <a
                class="rr-header__link"
                href="{{ link.url }}"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title -}}
              </a>
            </li>
          {%- endfor -%}
          {%- if show_cart -%}
            <li class="rr-header__cart-item">
              <a
                class="rr-header__link rr-header__pill rr-header__cart"
                href="{{ routes.cart_url }}"
                aria-label="{{ 'accessibility.cart' | t }}{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}"
                {% if request.page_type == 'cart' %}
                  aria-current="page"
                {% endif %}
              >
                <svg class="rr-header__icon" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M5 8h14l-1.2 12H6.2L5 8z"></path>
                  <path d="M9 8V6.5a3 3 0 0 1 6 0V8"></path>
                </svg>
                <span class="rr-header__cart-text">{{ 'accessibility.cart' | t }}</span>
                {%- if cart.item_count > 0 -%}
                  <span class="rr-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
                {%- endif -%}
              </a>
            </li>
          {%- endif -%}
          {%- if show_account -%}
            <li class="rr-header__account" data-rr-account>
              {%- if customer -%}
                <button
                  class="rr-header__link rr-header__pill rr-header__account-btn"
                  type="button"
                  aria-label="{{ 'accessibility.account' | t }}"
                  aria-expanded="false"
                  aria-controls="rr-account-menu-{{ section.id }}"
                  data-rr-account-toggle
                >
                  <svg class="rr-header__icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="8" r="4"></circle>
                    <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"></path>
                  </svg>
                  <svg class="rr-header__caret" aria-hidden="true" focusable="false" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.2">
                    <path d="M1 3l4 4 4-4"></path>
                  </svg>
                </button>
                <ul class="rr-header__dropdown" id="rr-account-menu-{{ section.id }}" hidden>
                  <li><a href="{{ routes.account_url }}">{{ 'riverrun_account.profile' | t }}</a></li>
                  <li><a href="{{ routes.account_url | append: '/orders' }}">{{ 'riverrun_account.orders' | t }}</a></li>
                  <li><a href="{{ routes.account_logout_url }}">{{ 'riverrun_account.sign_out' | t }}</a></li>
                </ul>
              {%- else -%}
                <a class="rr-header__link rr-header__pill rr-header__login" href="{{ routes.account_login_url }}">
                  <svg class="rr-header__icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="8" r="4"></circle>
                    <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"></path>
                  </svg>
                  <span>{{ 'riverrun_account.login' | t }}</span>
                </a>
              {%- endif -%}
            </li>
          {%- endif -%}
        </ul>
      </nav>

      <button
        class="rr-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="rr-mobile-menu-{{ section.id }}"
        data-rr-toggle
      >
        <span class="rr-header__toggle-label">{{ 'accessibility.menu' | t }}</span>
        <span class="rr-header__toggle-bars" aria-hidden="true"></span>
      </button>
    {%- endif -%}
  </div>

  {%- if menu != blank -%}
    <nav class="rr-header__mobile" id="rr-mobile-menu-{{ section.id }}" aria-label="{{ 'accessibility.menu' | t }}" hidden>
      <ul>
        {%- for link in menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
        {%- if show_cart -%}
          <li>
            <a href="{{ routes.cart_url }}">
              {{- 'accessibility.cart' | t -}}
              {%- if cart.item_count > 0 %} ({{ cart.item_count }}){% endif -%}
            </a>
          </li>
        {%- endif -%}
        {%- if show_account -%}
          {%- if customer -%}
            <li><a href="{{ routes.account_url }}">{{ 'riverrun_account.profile' | t }}</a></li>
            <li><a href="{{ routes.account_url | append: '/orders' }}">{{ 'riverrun_account.orders' | t }}</a></li>
            <li><a href="{{ routes.account_logout_url }}">{{ 'riverrun_account.sign_out' | t }}</a></li>
          {%- else -%}
            <li><a href="{{ routes.account_login_url }}">{{ 'riverrun_account.login' | t }}</a></li>
          {%- endif -%}
        {%- endif -%}
      </ul>
    </nav>
  {%- endif -%}
</rr-header>

<script src="{{ 'riverrun-header.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .rr-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    color: var(--rr-white);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
  }

  .rr-header[data-visible] {
    opacity: 1;
    pointer-events: auto;
  }

  .rr-header__bar {
    display: flex;
    align-items: center;
    height: var(--rr-header-height);
    padding-inline: max(var(--rr-gutter), calc((100% - var(--rr-grid-width)) / 2));
    background: rgb(27 27 26 / 94%);
    backdrop-filter: blur(8px);
  }

  .rr-header__logo {
    display: block;
    line-height: 0;
    transition: opacity 0.5s ease;
  }

  .rr-header[data-on-footer] .rr-header__logo {
    opacity: 0;
    pointer-events: none;
  }

  .rr-header__logo-img {
    display: block;
    width: auto;
    height: 34px;
  }

  .rr-header__logo-text {
    font-family: var(--rr-font-caps);
    color: var(--rr-yellow);
    font-size: 1.25rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1;
  }

  .rr-header__nav {
    margin-inline-start: auto;
  }

  .rr-header__list {
    display: flex;
    align-items: center;
    gap: clamp(44px, 6vw, 104px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rr-header__link {
    font-family: var(--rr-font-serif);
    font-size: 17px;
    letter-spacing: 0.09em;
    color: var(--rr-white);
    text-decoration: none;
    padding-block: 3px;
    border-block-end: 1px solid transparent;
    transition:
      color 0.3s ease,
      border-color 0.3s ease;
  }

  .rr-header__link:hover,
  .rr-header__link:focus-visible {
    color: var(--rr-red);
    border-block-end-color: var(--rr-yellow);
  }

  .rr-header__link[aria-current='page'] {
    color: var(--rr-white);
    border-block-end-color: var(--rr-yellow);
  }

  .rr-header__account {
    position: relative;
  }

  /* Sit the login / account item close to the cart icon instead of a full menu gap away. */
  .rr-header__cart-item + .rr-header__account {
    margin-inline-start: calc(12px - clamp(44px, 6vw, 104px));
  }

  /* Cart and login / account share one rounded outline button style. */
  .rr-header__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 18px;
    border: 1px solid rgb(239 235 221 / 40%);
    border-radius: 999px;
    background: none;
    cursor: pointer;
    font-family: var(--rr-font-serif);
    font-size: 17px;
    letter-spacing: 0.09em;
    line-height: 1;
  }

  .rr-header__pill:hover,
  .rr-header__pill:focus-visible,
  .rr-header__pill[aria-current='page'],
  .rr-header__pill[aria-expanded='true'] {
    border-color: var(--rr-yellow);
  }

  /* Logged-out Login is the one filled button: yellow ground with dark text. */
  .rr-header__login {
    border-color: var(--rr-yellow);
    background: var(--rr-yellow);
    color: var(--rr-ink);
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .rr-header__login:hover,
  .rr-header__login:focus-visible {
    background: transparent;
    color: var(--rr-yellow);
  }

  .rr-header__cart-count {
    display: grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding-inline: 5px;
    border-radius: 9px;
    background: var(--rr-yellow);
    color: var(--rr-ink);
    font-family: var(--rr-font-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
  }

  .rr-header__caret {
    transition: transform 0.3s ease;
  }

  .rr-header__account-btn[aria-expanded='true'] .rr-header__caret {
    transform: rotate(180deg);
  }

  .rr-header__dropdown:not([hidden]) {
    position: absolute;
    inset-block-start: calc(100% + 16px);
    inset-inline-end: 0;
    min-width: 170px;
    margin: 0;
    padding: 8px 0;
    list-style: none;
    background: rgb(27 27 26 / 97%);
    border-block-start: 1px solid var(--rr-yellow);
  }

  .rr-header__dropdown a {
    display: block;
    padding: 11px 22px;
    font-family: var(--rr-font-serif);
    font-size: 16px;
    letter-spacing: 0.09em;
    color: var(--rr-light);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.3s ease;
  }

  .rr-header__dropdown a:hover,
  .rr-header__dropdown a:focus-visible {
    color: var(--rr-red);
  }

  .rr-header__dropdown a:focus-visible,
  .rr-header__link:focus-visible,
  .rr-header__toggle:focus-visible,
  .rr-header__mobile a:focus-visible {
    outline: 2px solid var(--rr-light);
    outline-offset: 4px;
  }

  .rr-header__toggle {
    display: none;
    margin-inline-start: auto;
    padding: 12px 4px;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
  }

  .rr-header__toggle-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .rr-header__toggle-bars,
  .rr-header__toggle-bars::before {
    display: block;
    width: 24px;
    height: 1px;
    background: var(--rr-light);
    content: '';
    transition: transform 0.3s ease;
  }

  .rr-header__toggle-bars::before {
    transform: translateY(-7px);
  }

  .rr-header__toggle-bars {
    box-shadow: 0 7px 0 var(--rr-light);
  }

  .rr-header__toggle[aria-expanded='true'] .rr-header__toggle-bars {
    box-shadow: none;
    transform: rotate(45deg);
  }

  .rr-header__toggle[aria-expanded='true'] .rr-header__toggle-bars::before {
    transform: rotate(-90deg);
  }

  .rr-header__mobile {
    display: none;
  }

  @media (max-width: 760px) {
    .rr-header__nav {
      display: none;
    }

    .rr-header__toggle {
      display: block;
    }

    .rr-header__logo-img {
      height: 28px;
    }

    .rr-header__mobile:not([hidden]) {
      display: block;
      padding: 12px var(--rr-gutter) 28px;
      background: rgb(27 27 26 / 97%);
    }

    .rr-header__mobile ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .rr-header__mobile a {
      display: block;
      padding: 14px 0;
      border-bottom: 1px solid rgb(239 235 221 / 15%);
      font-family: var(--rr-font-serif);
      font-size: 22px;
      letter-spacing: 0.09em;
      color: var(--rr-light);
      text-decoration: none;
    }

    .rr-header__mobile a:hover {
      color: var(--rr-red);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rr-header,
    .rr-header__logo,
    .rr-header__toggle-bars,
    .rr-header__toggle-bars::before {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Riverrun header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Gold logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show login / account menu",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart",
      "default": true
    }
  ]
}
{% endschema %}
