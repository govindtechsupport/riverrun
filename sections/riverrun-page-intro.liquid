{% comment %}
  Section contract.
  Intro block for the Riverrun inner pages (Bespoke, About, Contact). Dark or beige ground,
  optional looping background video or photo, the 川道 mark, the page heading (the only H1)
  and rich text. Reads the page title unless a heading is set.
  @example
  <!-- templates/page.about.json: with the shoji video behind the text -->
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | default: page.title
  assign dark = false
  if section.settings.style == 'dark'
    assign dark = true
  endif
-%}

<section
  class="rr-intro{% if dark %} rr-intro--dark{% endif %}"
  {{ section.shopify_attributes }}
>
  {%- if section.settings.video != blank -%}
    <video
      class="rr-intro__media"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
      tabindex="-1"
      {% if section.settings.image != blank %}
        poster="{{ section.settings.image | image_url: width: 1600 }}"
      {% endif %}
      data-rr-band-video
    >
      {%- for source in section.settings.video.sources -%}
        <source src="{{ source.url }}" type="{{ source.mime_type }}">
      {%- endfor -%}
    </video>
  {%- elsif section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2000
      | image_tag: alt: '', widths: '800, 1200, 1600, 2000', sizes: '100vw', loading: 'eager', class: 'rr-intro__media'
    }}
  {%- endif -%}

  <div class="rr-intro__inner">
    {%- if section.settings.mark != blank -%}
      <span class="rr-intro__mark" aria-hidden="true">{{ section.settings.mark }}</span>
    {%- endif -%}
    <h1 class="rr-intro__heading">{{ heading }}</h1>
    {%- if section.settings.text != blank -%}
      <div class="rr-intro__text">{{ section.settings.text }}</div>
    {%- elsif page.content != blank -%}
      <div class="rr-intro__text">{{ page.content }}</div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll('.rr-intro video').forEach((v) => {
      v.removeAttribute('autoplay');
      v.pause();
    });
  })();
</script>

{% stylesheet %}
  .rr-intro {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 62vh;
    padding: calc(var(--rr-header-height) + 72px) var(--rr-gutter) 88px;
    overflow: hidden;
    background: var(--rr-card);
    color: var(--rr-ink);
    text-align: center;
  }

  .rr-intro--dark {
    background: var(--rr-dark);
    color: var(--rr-light);
  }

  .rr-intro--dark::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgb(27 27 26 / 55%);
    content: '';
  }

  .rr-intro__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rr-intro__inner {
    position: relative;
    z-index: 2;
    max-width: 640px;
  }

  .rr-intro__mark {
    display: block;
    margin-bottom: 22px;
    font-family: var(--rr-font-cjk);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.3em;
    text-indent: 0.3em;
    color: var(--rr-red);
  }

  .rr-intro__heading {
    margin: 0 0 28px;
    font-family: var(--rr-font-caps);
    font-size: clamp(28px, 3.6vw, 52px);
    font-weight: 400;
    letter-spacing: 0.16em;
    text-indent: 0.16em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .rr-intro--dark .rr-intro__heading {
    color: var(--rr-yellow);
  }

  .rr-intro__text {
    font-family: var(--rr-font-body);
    font-size: 15px;
    line-height: 1.8;
  }

  .rr-intro__text p {
    margin: 0 0 1em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Riverrun page intro",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "paper", "label": "Paper (beige)" },
        { "value": "dark", "label": "Dark (over photo or video)" }
      ],
      "default": "paper"
    },
    { "type": "text", "id": "mark", "label": "Mark", "info": "For example 川道. Leave empty to hide it.", "default": "川道" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the page title." },
    { "type": "richtext", "id": "text", "label": "Text", "info": "Leave empty to use the page content." },
    { "type": "video", "id": "video", "label": "Background video" },
    { "type": "image_picker", "id": "image", "label": "Background photo" }
  ],
  "presets": [{ "name": "Riverrun page intro" }]
}
{% endschema %}
