{% comment %}
  Section contract.
  Bespoke orders page, chosen option 1 (band + yellow): a looping video band under the
  header with the gold line "Looking for something specific?", then a yellow section with
  the heading "Bespoke orders & collaborations", the intro text and an enquiry button.
  Falls back to the built-in bespoke band video. The button opens an email (subject
  "Bespoke enquiry") when an email is set, otherwise it goes to the link you choose
  (for example the contact page). With reduced motion the video is replaced by its still frame.
  @example
  <!-- templates/page.bespoke.json -->
{% endcomment %}

{%- liquid
  assign poster_url = 'riverrun-bespoke-band-still.jpg' | asset_url
  if section.settings.poster != blank
    assign poster_url = section.settings.poster | image_url: width: 1920
  endif

  assign enquiry_href = section.settings.link
  if section.settings.email != blank
    assign encoded_subject = section.settings.subject | url_encode
    assign enquiry_href = 'mailto:' | append: section.settings.email | append: '?subject=' | append: encoded_subject
  endif
-%}

<section class="rr-bespoke" {{ section.shopify_attributes }}>
  <div class="rr-bespoke__band" style="--rr-bespoke-poster: url('{{ poster_url }}')">
    <video
      class="rr-bespoke__video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
      tabindex="-1"
      poster="{{ poster_url }}"
    >
      {%- if section.settings.video != blank -%}
        {%- for source in section.settings.video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      {%- else -%}
        <source src="{{ 'riverrun-bespoke-band.mp4' | asset_url }}" type="video/mp4">
      {%- endif -%}
    </video>
    <div class="rr-bespoke__band-inner">
      <h1 class="rr-bespoke__headline">{{ section.settings.headline }}</h1>
    </div>
  </div>

  <div class="rr-bespoke__intro">
    <div class="rr-bespoke__wrap">
      <div class="rr-bespoke__grid">
        <h2 class="rr-bespoke__title">{{ section.settings.heading | newline_to_br }}</h2>
        <div>
          <div class="rr-bespoke__body">{{ section.settings.text }}</div>
          {%- if enquiry_href != blank and section.settings.button_label != blank -%}
            <a class="rr-bespoke__btn" href="{{ enquiry_href }}">{{ section.settings.button_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll('.rr-bespoke video').forEach((v) => {
      v.pause();
      v.removeAttribute('autoplay');
      v.hidden = true;
    });
  })();
</script>

{% stylesheet %}
  .rr-bespoke {
    padding-top: var(--rr-header-height);
    background: var(--rr-dark);
  }

  .rr-bespoke__band {
    position: relative;
    height: 62vh;
    min-height: 440px;
    overflow: hidden;
    background: var(--rr-dark) var(--rr-bespoke-poster) center / cover;
    color: #fff;
  }

  .rr-bespoke__band::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgb(10 9 8 / 50%);
    content: '';
  }

  .rr-bespoke__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rr-bespoke__band-inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 0 16px;
    text-align: center;
  }

  .rr-bespoke__headline {
    margin: 0;
    font-family: var(--rr-font-caps);
    font-size: clamp(30px, 3.6vw, 52px);
    font-weight: 400;
    letter-spacing: 0.16em;
    text-wrap: balance;
    color: var(--rr-yellow);
  }

  .rr-bespoke__intro {
    padding: 96px 0;
    background: var(--rr-yellow);
    color: var(--rr-ink);
  }

  .rr-bespoke__wrap {
    width: min(var(--rr-grid-width), calc(100% - var(--rr-gutter) * 2));
    margin: 0 auto;
  }

  .rr-bespoke__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 36px;
    align-items: start;
  }

  .rr-bespoke__title {
    margin: 0;
    font-family: var(--rr-font-serif);
    font-size: clamp(44px, 4.6vw, 66px);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .rr-bespoke__body {
    max-width: 46ch;
    padding-top: 10px;
    font-family: var(--rr-font-body);
    font-size: 15px;
    font-style: italic;
    line-height: 1.7;
  }

  .rr-bespoke__body p {
    margin: 0 0 18px;
  }

  .rr-bespoke__body p:last-child {
    margin-bottom: 0;
  }

  .rr-bespoke__btn {
    display: inline-block;
    margin-top: 36px;
    padding: 15px 28px;
    background: var(--rr-ink);
    color: var(--rr-card);
    font-family: var(--rr-font-body);
    font-size: 13px;
    font-style: italic;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 0.3s ease;
  }

  .rr-bespoke__btn:hover,
  .rr-bespoke__btn:focus-visible {
    background: var(--rr-red);
  }

  .rr-bespoke__btn:focus-visible {
    outline: 2px solid var(--rr-ink);
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .rr-bespoke__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 760px) {
    .rr-bespoke__intro {
      padding: 64px 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Riverrun Bespoke",
  "settings": [
    { "type": "header", "content": "Video band" },
    { "type": "text", "id": "headline", "label": "Band headline", "default": "Looking for something specific?" },
    { "type": "video", "id": "video", "label": "Video", "info": "Leave empty to use the built-in bespoke band video." },
    { "type": "image_picker", "id": "poster", "label": "Still frame" },
    { "type": "header", "content": "Yellow section" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Bespoke orders\n& collaborations" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our Riverrun team travels to China often, wandering the markets and back-street workshops in search of pieces worth bringing home. Everything in the shop is chosen by hand.</p><p>But sometimes what you have in mind hasn't crossed our path yet. Tell us what you are looking for and we will hunt for it on our next trip, or have it made from scratch by one of our verified craftsmen.</p><p>From a single made-to-measure piece to full interior design consultancy, we love to help you find something that truly belongs.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Make an enquiry" },
    { "type": "text", "id": "email", "label": "Enquiry email", "info": "hello@riverrun.co.za is still to be confirmed by the client." },
    { "type": "text", "id": "subject", "label": "Email subject", "default": "Bespoke enquiry" },
    { "type": "url", "id": "link", "label": "Enquiry link", "info": "Used when no email is set, for example the contact page." }
  ],
  "presets": [{ "name": "Riverrun Bespoke" }]
}
{% endschema %}
