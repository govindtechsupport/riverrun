{% comment %}
  Section contract.
  One full-width photo with a slight dark overlay and a beige card on it: "Visit the
  showroom", the address, a thin line, and "Contact us for opening hours" with the email.
  No phone number is shown anywhere (client's wish).
  @example
  <!-- templates/index.json: after the bespoke band -->
{% endcomment %}

<section class="rr-showroom" {{ section.shopify_attributes }}>
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2400
      | image_tag: alt: '', widths: '800, 1200, 1600, 2400', sizes: '100vw', loading: 'lazy', class: 'rr-showroom__photo'
    }}
  {%- else -%}
    <img
      class="rr-showroom__photo"
      src="{{ 'riverrun-showroom.jpg' | asset_url }}"
      alt=""
      width="1600"
      height="900"
      loading="lazy"
    >
  {%- endif -%}

  <div class="rr-showroom__card">
    <h2 class="rr-showroom__label">{{ section.settings.label }}</h2>
    <p class="rr-showroom__address">{{ section.settings.address | newline_to_br }}</p>
    <hr class="rr-showroom__rule">
    <p class="rr-showroom__contact">
      {{ section.settings.contact_text }}
      {%- if section.settings.email != blank -%}
        <br><a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email }}</a>
      {%- endif -%}
    </p>
  </div>
</section>

{% stylesheet %}
  .rr-showroom {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 48px 16px;
    overflow: hidden;
    background: #3a3a38;
  }

  .rr-showroom::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgb(0 0 0 / 30%);
    content: '';
  }

  .rr-showroom__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
  }

  .rr-showroom__card {
    position: relative;
    z-index: 2;
    min-width: min(460px, calc(100vw - 32px));
    padding: 56px 72px;
    background: var(--rr-card);
    box-shadow: 0 24px 60px rgb(0 0 0 / 30%);
    color: var(--rr-ink);
    text-align: center;
  }

  .rr-showroom__label {
    margin: 0 0 28px;
    font-family: var(--rr-font-caps);
    -webkit-text-stroke: 0.35px currentColor;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .rr-showroom__address {
    margin: 0;
    font-family: var(--rr-font-serif);
    font-size: 32px;
    line-height: 1.25;
  }

  .rr-showroom__rule {
    width: 48px;
    margin: 28px auto;
    border: 0;
    border-top: 1px solid var(--rr-ink);
  }

  .rr-showroom__contact {
    margin: 0;
    font-family: var(--rr-font-body);
    font-size: 14px;
    line-height: 1.7;
  }

  .rr-showroom__contact a {
    color: inherit;
  }

  .rr-showroom__contact a:hover {
    color: var(--rr-red);
  }

  @media (max-width: 760px) {
    .rr-showroom__card {
      padding: 40px 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Riverrun showroom",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Showroom photo" },
    { "type": "text", "id": "label", "label": "Label", "default": "Visit the showroom" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "5 Maynard Street\nCape Town" },
    { "type": "text", "id": "contact_text", "label": "Contact line", "default": "Contact us for opening hours:" },
    { "type": "text", "id": "email", "label": "Email address", "info": "hello@riverrun.co.za is still to be confirmed by the client.", "default": "hello@riverrun.co.za" }
  ],
  "presets": [{ "name": "Riverrun showroom" }]
}
{% endschema %}
