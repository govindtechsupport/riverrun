{% comment %}
  Section contract.
  Four equal tall photo tiles that touch edge to edge (two by two on phones). Each tile has
  a two-line label in wide-spaced capitals and the character 央 below it. On hover the photo
  brightens and zooms, a yellow frame and rule draw in, the label lifts, 央 turns red and the
  other tiles recede. Add up to four `tile` blocks.
  @example
  <!-- templates/index.json: after the opening section -->
{% endcomment %}

<section class="rr-tiles" id="rr-tiles" {{ section.shopify_attributes }}>
  {%- for block in section.blocks -%}
    <a class="rr-tile" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        {{
          block.settings.image
          | image_url: width: 1000
          | image_tag:
            alt: '',
            widths: '400, 600, 800, 1000',
            sizes: '(max-width: 760px) 50vw, 25vw',
            loading: 'lazy',
            class: 'rr-tile__img'
        }}
      {%- else -%}
        {%- assign fallback = 'riverrun-tile-' | append: forloop.index | append: '.jpg' -%}
        <img
          class="rr-tile__img"
          src="{{ fallback | asset_url }}"
          alt=""
          width="1387"
          height="2400"
          loading="lazy"
        >
      {%- endif -%}
      <span class="rr-tile__frame" aria-hidden="true"></span>
      <span class="rr-tile__label">{{ block.settings.label | newline_to_br | strip_newlines }}</span>
      <span class="rr-tile__mark" aria-hidden="true">{{ block.settings.mark }}</span>
    </a>
  {%- endfor -%}
</section>

{% stylesheet %}
  .rr-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    background: var(--rr-yellow);
  }

  .rr-tile {
    position: relative;
    display: block;
    aspect-ratio: 259 / 448;
    overflow: hidden;
    background: var(--rr-dark);
    color: var(--rr-white);
    text-decoration: none;
  }

  .rr-tile__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .rr-tile:hover .rr-tile__img,
  .rr-tile:focus-visible .rr-tile__img {
    transform: scale(1.07);
  }

  .rr-tile::before,
  .rr-tile::after {
    position: absolute;
    z-index: 1;
    pointer-events: none;
    content: '';
  }

  .rr-tile::before {
    inset: 0;
    background: rgb(0 0 0 / 30%);
    transition: opacity 0.6s ease;
  }

  .rr-tile:hover::before,
  .rr-tile:focus-visible::before {
    opacity: 0.45;
  }

  .rr-tile__frame {
    position: absolute;
    inset: 14px;
    z-index: 2;
    border: 1px solid var(--rr-yellow);
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 0.6s ease,
      transform 0.9s cubic-bezier(0.22, 0.61, 0.36, 1);
    pointer-events: none;
  }

  .rr-tile:hover .rr-tile__frame,
  .rr-tile:focus-visible .rr-tile__frame {
    opacity: 1;
    transform: none;
  }

  /* Other tiles recede while one is hovered (pointer devices only). */
  @media (hover: hover) {
    .rr-tile__img {
      transition:
        transform 1.1s cubic-bezier(0.22, 0.61, 0.36, 1),
        filter 0.6s ease;
    }

    .rr-tiles:has(.rr-tile:hover) .rr-tile:not(:hover) .rr-tile__img {
      filter: saturate(0.5) brightness(0.75);
    }
  }

  .rr-tile::after {
    right: 0;
    bottom: 0;
    left: 0;
    height: 58%;
    background: linear-gradient(rgb(0 0 0 / 0%), rgb(0 0 0 / 38%));
  }

  .rr-tile__label,
  .rr-tile__mark {
    position: absolute;
    right: 0;
    left: 0;
    z-index: 2;
    text-align: center;
    transition:
      transform 1.1s cubic-bezier(0.22, 0.61, 0.36, 1),
      color 0.4s ease;
  }

  .rr-tile__label {
    bottom: 23%;
    font-family: var(--rr-font-caps);
    font-size: clamp(12px, 1.25vw, 19px);
    letter-spacing: 0.22em;
    text-indent: 0.22em;
    line-height: 1.7;
    text-transform: uppercase;
  }

  .rr-tile__mark {
    bottom: 5%;
    font-family: var(--rr-font-cjk);
    font-size: clamp(38px, 4.6vw, 70px);
    font-weight: 500;
    line-height: 1;
  }

  .rr-tile__label::after {
    display: block;
    width: 34px;
    height: 1px;
    margin: 10px auto 0;
    background: var(--rr-yellow);
    transform: scaleX(0);
    transition: transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) 0.1s;
    content: '';
  }

  .rr-tile:hover .rr-tile__label,
  .rr-tile:focus-visible .rr-tile__label {
    transform: translateY(-6%);
  }

  .rr-tile:hover .rr-tile__label::after,
  .rr-tile:focus-visible .rr-tile__label::after {
    transform: none;
  }

  .rr-tile:hover .rr-tile__mark,
  .rr-tile:focus-visible .rr-tile__mark {
    color: var(--rr-red);
    transform: translateY(-3%);
  }

  .rr-tile:focus-visible {
    outline: 2px solid var(--rr-white);
    outline-offset: -6px;
  }

  @media (max-width: 760px) {
    .rr-tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rr-tile__img,
    .rr-tile__label,
    .rr-tile__label::after,
    .rr-tile__frame,
    .rr-tile::before,
    .rr-tile__mark {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Riverrun tiles",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "textarea", "id": "label", "label": "Label", "info": "Two lines, for example: the collection", "default": "the\ncollection" },
        { "type": "text", "id": "mark", "label": "Character", "default": "央" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Riverrun tiles",
      "blocks": [
        { "type": "tile", "settings": { "label": "the\ncollection" } },
        { "type": "tile", "settings": { "label": "bespoke\norders" } },
        { "type": "tile", "settings": { "label": "about\nRiverrun" } },
        { "type": "tile", "settings": { "label": "contact\nus" } }
      ]
    }
  ]
}
{% endschema %}
