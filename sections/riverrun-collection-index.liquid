{% comment %}
  Section contract.
  Riverrun collection index with the same yellow ground, centered heading, and four-column
  card grid as the shop page. Each collection card uses its featured image or first product image.
  @example
  <!-- templates/list-collections.json -->
{% endcomment %}

{% render 'riverrun-collection-styles' %}

<section class="rr-collection rr-collection--index" {{ section.shopify_attributes }}>
  <div class="rr-collection__head">
    <h1 class="rr-collection__title">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.intro != blank -%}
      <p class="rr-collection__intro">{{ section.settings.intro | escape }}</p>
    {%- endif -%}
  </div>

  <div class="rr-collection__grid">
    {%- for collection in collections limit: 20 -%}
      {%- unless collection.handle == 'all' -%}
        {%- liquid
          assign card_image = collection.featured_image
          if card_image == blank and collection.products.first != blank
            assign card_image = collection.products.first.featured_image
          endif

          assign image_loading = 'lazy'
          assign image_fetchpriority = 'auto'
          if forloop.index <= 4
            assign image_loading = 'eager'
            assign image_fetchpriority = 'high'
          endif
        -%}
        <a class="rr-index-card" href="{{ collection.url }}">
          <span class="rr-index-card__media">
            {%- if card_image != blank -%}
              {{
                card_image
                | image_url: width: 1000
                | image_tag:
                  alt: '',
                  widths: '300, 450, 600, 800, 1000',
                  sizes: '(max-width: 760px) 45vw, (max-width: 1200px) 30vw, 280px',
                  loading: image_loading,
                  fetchpriority: image_fetchpriority,
                  class: 'rr-index-card__image'
              }}
            {%- endif -%}
          </span>
          <span class="rr-index-card__title">{{ collection.title | escape }}</span>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .rr-collection--index .rr-collection__grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .rr-index-card {
    display: grid;
    min-width: 0;
    aspect-ratio: 3 / 4;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: clamp(14px, 2vw, 26px);
    padding: clamp(16px, 2.2vw, 30px);
    background: var(--rr-card);
    color: var(--rr-ink);
    text-decoration: none;
    transition:
      background-color 0.4s ease,
      transform 0.4s ease,
      box-shadow 0.4s ease;
  }

  .rr-index-card:hover,
  .rr-index-card:focus-visible {
    background: #faf6ea;
    box-shadow: 0 18px 30px rgb(60 40 10 / 18%);
    transform: translateY(-4px);
  }

  .rr-index-card:focus-visible {
    outline: 2px solid var(--rr-ink);
    outline-offset: 3px;
  }

  .rr-index-card__media {
    display: grid;
    min-height: 0;
    place-items: center;
  }

  .rr-index-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 12px 12px rgb(40 30 15 / 14%));
  }

  .rr-index-card__title {
    font-family: var(--rr-font-caps);
    font-size: clamp(12px, 1.15vw, 16px);
    letter-spacing: 0.18em;
    line-height: 1.35;
    text-align: center;
    text-transform: uppercase;
    -webkit-text-stroke: 0.35px currentColor;
  }

  @media (max-width: 760px) {
    .rr-collection--index .rr-collection__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .rr-index-card {
      gap: 14px;
      padding: 14px;
    }

    .rr-index-card__title {
      font-size: 11px;
      letter-spacing: 0.12em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rr-index-card {
      transition: none;
    }

    .rr-index-card:hover,
    .rr-index-card:focus-visible {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Riverrun collection index",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "text", "id": "intro", "label": "Intro line", "default": "Explore our collections of original pieces from China." }
  ]
}
{% endschema %}
