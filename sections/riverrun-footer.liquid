{% comment %}
  Section contract.
  Riverrun footer, lined up with the page margin: gold logo with the tagline underneath, then
  three columns: Showroom (address on two lines and "Get directions" to Google Maps), Explore
  (Shop, Bespoke, About, Contact) and Info (Shipping, Terms, Privacy policy and a small
  Instagram icon underneath), then the copyright on its own row at the left. No email, website link, payment icons or currency selector.
  Outputs LocalBusiness structured data (name, address, email, Instagram) for Google.
  The logo carries `data-rr-footer-logo` so the header logo can fade out when it appears.
  @example
  <!-- Lives in sections/footer-group.json -->
{% endcomment %}

{%- liquid
  assign address_text = section.settings.address
  assign address_inline = address_text | newline_to_br | replace: '<br />', ', '
  assign map_href = section.settings.map_url
  if map_href == blank
    assign map_query = address_inline | strip_html | url_encode
    assign map_href = 'https://www.google.com/maps/search/?api=1&query=' | append: map_query
  endif

  assign shipping_href = section.settings.shipping_url | default: '/policies/shipping-policy'
  assign terms_href = section.settings.terms_url | default: '/policies/terms-of-service'
  assign privacy_href = section.settings.privacy_url | default: '/policies/privacy-policy'
  assign instagram_href = section.settings.instagram_url | default: 'https://www.instagram.com/riverrun_decor'

  assign shop_href = section.settings.shop_url | default: '/#rr-shop'
  assign bespoke_href = section.settings.bespoke_url | default: '/pages/bespoke'
  assign about_href = section.settings.about_url | default: '/pages/about'
  assign contact_href = section.settings.contact_url | default: '/pages/contact'
-%}

<footer class="rr-footer" {{ section.shopify_attributes }}>
  <div class="rr-footer__lockup" data-rr-footer-logo>
    {%- if section.settings.logo != blank -%}
      {{
        section.settings.logo
        | image_url: width: 400
        | image_tag: alt: shop.name, width: 190, loading: 'lazy', class: 'rr-footer__logo'
      }}
    {%- else -%}
      <img
        class="rr-footer__logo"
        src="{{ 'riverrun-logo-gold.png' | asset_url }}"
        alt="{{ shop.name | escape }}"
        width="190"
        height="36"
        loading="lazy"
      >
    {%- endif -%}
    {%- if section.settings.tagline != blank -%}
      <span class="rr-footer__tagline">{{ section.settings.tagline }}</span>
    {%- endif -%}
  </div>

  <div class="rr-footer__col">
    <p class="rr-footer__heading">{{ section.settings.showroom_heading }}</p>
    <p class="rr-footer__text">{{ address_text | escape | newline_to_br }}</p>
    {%- if section.settings.directions_label != blank -%}
      <a class="rr-footer__link rr-footer__directions" href="{{ map_href }}" target="_blank" rel="noopener">
        {{- section.settings.directions_label -}}
      </a>
    {%- endif -%}
  </div>

  <nav class="rr-footer__col" aria-label="{{ section.settings.explore_heading | escape }}">
    <p class="rr-footer__heading">{{ section.settings.explore_heading }}</p>
    <ul class="rr-footer__list">
      <li><a class="rr-footer__link" href="{{ shop_href }}">{{ section.settings.shop_label }}</a></li>
      <li><a class="rr-footer__link" href="{{ bespoke_href }}">{{ section.settings.bespoke_label }}</a></li>
      <li><a class="rr-footer__link" href="{{ about_href }}">{{ section.settings.about_label }}</a></li>
      <li><a class="rr-footer__link" href="{{ contact_href }}">{{ section.settings.contact_label }}</a></li>
    </ul>
  </nav>

  <div class="rr-footer__col">
    <p class="rr-footer__heading">{{ section.settings.info_heading }}</p>
    <ul class="rr-footer__list">
      <li><a class="rr-footer__link" href="{{ shipping_href }}">{{ section.settings.shipping_label }}</a></li>
      <li><a class="rr-footer__link" href="{{ terms_href }}">{{ section.settings.terms_label }}</a></li>
      <li><a class="rr-footer__link" href="{{ privacy_href }}">{{ section.settings.privacy_label }}</a></li>
      <li>
        <a class="rr-footer__link rr-footer__social" href="{{ instagram_href }}" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor"/></svg>
        </a>
      </li>
    </ul>
  </div>

  <p class="rr-footer__muted rr-footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
</footer>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "address": {{ address_inline | strip_html | json }},
    {%- if section.settings.email != blank %}
    "email": {{ section.settings.email | json }},
    {%- endif %}
    "sameAs": [{{ instagram_href | json }}]
  }
</script>

{% stylesheet %}
  .rr-footer {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
    padding: 52px max(var(--rr-gutter), calc((100% - var(--rr-grid-width)) / 2));
    background: var(--rr-dark);
    color: var(--rr-light);
    font-family: var(--rr-font-body);
    font-size: 11px;
    letter-spacing: 0.1em;
    line-height: 1.9;
    text-transform: uppercase;
  }

  .rr-footer a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .rr-footer a:hover,
  .rr-footer a:focus-visible {
    color: var(--rr-red);
  }

  .rr-footer a:focus-visible {
    outline: 2px solid var(--rr-light);
    outline-offset: 3px;
  }

  .rr-footer__lockup {
    width: min(190px, 100%);
  }

  .rr-footer__logo {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 9px;
  }

  .rr-footer__tagline {
    display: block;
    font-family: var(--rr-font-caps);
    font-size: 7.5px;
    letter-spacing: 0.34em;
    word-spacing: 0.3em;
    text-indent: 0.34em;
    text-align: center;
    white-space: nowrap;
    line-height: 1.4;
    opacity: 0.9;
  }

  .rr-footer__heading {
    margin: 0 0 6px;
    font-family: var(--rr-font-caps);
    opacity: 0.65;
  }

  .rr-footer__text {
    margin: 0;
  }

  .rr-footer__directions {
    display: inline-block;
    margin-top: 6px;
    border-bottom: 1px solid currentcolor;
    line-height: 1.5;
  }

  .rr-footer__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rr-footer__social {
    display: inline-flex;
    align-items: center;
    height: 1.9em;
  }

  .rr-footer .rr-footer__social:hover,
  .rr-footer .rr-footer__social:focus-visible {
    color: var(--rr-yellow);
  }

  .rr-footer__muted {
    margin: 0;
    opacity: 0.65;
  }

  .rr-footer__copy {
    grid-column: 1 / -1;
    margin-top: 12px;
    text-align: start;
  }

  @media (max-width: 760px) {
    .rr-footer {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-block: 36px;
    }

    .rr-footer__lockup {
      grid-column: 1 / -1;
      width: min(170px, 100%);
    }

    .rr-footer__tagline {
      white-space: normal;
      letter-spacing: 0.3em;
      word-spacing: 0.2em;
      text-indent: 0.3em;
      line-height: 1.8;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Riverrun footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Gold logo" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Handpicked Chinese furniture" },
    { "type": "header", "content": "Showroom" },
    { "type": "text", "id": "showroom_heading", "label": "Heading", "default": "Showroom" },
    { "type": "textarea", "id": "address", "label": "Address", "info": "Shown on two lines.", "default": "5 Maynard Street\nCape Town" },
    { "type": "text", "id": "directions_label", "label": "Directions link text", "default": "Get directions" },
    { "type": "url", "id": "map_url", "label": "Directions link", "info": "Optional. Leave empty to search the address on Google Maps." },
    { "type": "header", "content": "Explore" },
    { "type": "text", "id": "explore_heading", "label": "Heading", "default": "Explore" },
    { "type": "text", "id": "shop_label", "label": "Shop label", "default": "Shop" },
    { "type": "url", "id": "shop_url", "label": "Shop link" },
    { "type": "text", "id": "bespoke_label", "label": "Bespoke label", "default": "Bespoke" },
    { "type": "url", "id": "bespoke_url", "label": "Bespoke link" },
    { "type": "text", "id": "about_label", "label": "About label", "default": "About" },
    { "type": "url", "id": "about_url", "label": "About link" },
    { "type": "text", "id": "contact_label", "label": "Contact label", "default": "Contact" },
    { "type": "url", "id": "contact_url", "label": "Contact link" },
    { "type": "header", "content": "Info" },
    { "type": "text", "id": "info_heading", "label": "Heading", "default": "Info" },
    { "type": "text", "id": "shipping_label", "label": "Shipping label", "default": "Shipping" },
    { "type": "url", "id": "shipping_url", "label": "Shipping link" },
    { "type": "text", "id": "terms_label", "label": "Terms label", "default": "Terms" },
    { "type": "url", "id": "terms_url", "label": "Terms link" },
    { "type": "text", "id": "privacy_label", "label": "Privacy policy label", "default": "Privacy policy" },
    { "type": "url", "id": "privacy_url", "label": "Privacy policy link", "info": "The privacy policy text is still to be supplied by the client. Until it is set, the link goes to the store's privacy policy page." },
    { "type": "url", "id": "instagram_url", "label": "Instagram link", "info": "Optional. Defaults to instagram.com/riverrun_decor." },
    { "type": "header", "content": "Google data" },
    { "type": "text", "id": "email", "label": "Email address", "info": "Not shown in the footer. Only sent to Google in the business data." }
  ],
  "presets": [{ "name": "Riverrun footer" }]
}
{% endschema %}
