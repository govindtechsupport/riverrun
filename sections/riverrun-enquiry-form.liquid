{% comment %}
  Section contract.
  Enquiry form for the Bespoke and Contact pages, using Shopify's native contact form
  (submissions are emailed to the store's customer email). Optional "Get in touch" column
  (email and Instagram, each with an icon) shown beside the form. No phone number by design.
  @example
  <!-- templates/page.bespoke.json: "Tell us what you are looking for" -->
{% endcomment %}

{%- liquid
  assign form_id = 'rr-enquiry-' | append: section.id
  assign email = section.settings.email
  assign instagram_handle = section.settings.instagram_handle
  assign show_details = false
  if email != blank or instagram_handle != blank
    assign show_details = true
  endif
-%}

<section class="rr-enquiry" {{ section.shopify_attributes }}>
  <div class="rr-enquiry__grid{% unless show_details %} rr-enquiry__grid--single{% endunless %}">
    {%- if show_details -%}
      <div class="rr-enquiry__details">
        {%- if section.settings.details_heading != blank -%}
          <h2 class="rr-enquiry__title">{{ section.settings.details_heading }}</h2>
        {%- endif -%}
        <ul class="rr-enquiry__list">
          {%- if email != blank -%}
            <li>
              <a class="rr-enquiry__contact" href="mailto:{{ email | escape }}">
                <svg class="rr-enquiry__icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3.5 6.5 8.5 7 8.5-7"/></svg>
                <span>{{ email }}</span>
              </a>
            </li>
          {%- endif -%}
          {%- if instagram_handle != blank -%}
            {%- assign handle = instagram_handle | remove: '@' | strip -%}
            {%- assign instagram_href = section.settings.instagram_url | default: 'https://www.instagram.com/' | append: handle -%}
            {%- if section.settings.instagram_url != blank -%}
              {%- assign instagram_href = section.settings.instagram_url -%}
            {%- endif -%}
            <li>
              <a class="rr-enquiry__contact" href="{{ instagram_href }}" target="_blank" rel="noopener">
                <svg class="rr-enquiry__icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor"/></svg>
                <span>@{{ handle }}</span>
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="rr-enquiry__formwrap">
      {%- if section.settings.heading != blank -%}
        <h2 class="rr-enquiry__title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- form 'contact', id: form_id, class: 'rr-enquiry__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="rr-enquiry__notice" role="status">{{ section.settings.success_message }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="rr-enquiry__notice rr-enquiry__notice--error" role="alert">
            {{ form.errors | default_errors }}
          </p>
        {%- endif -%}

        <label class="rr-enquiry__field" for="{{ form_id }}-name">
          <span>{{ section.settings.name_label }}</span>
          <input id="{{ form_id }}-name" name="contact[name]" type="text" autocomplete="name" required value="{{ form.name | escape }}">
        </label>

        <label class="rr-enquiry__field" for="{{ form_id }}-email">
          <span>{{ section.settings.email_label }}</span>
          <input id="{{ form_id }}-email" name="contact[email]" type="email" autocomplete="email" required value="{{ form.email | escape }}">
        </label>

        <label class="rr-enquiry__field" for="{{ form_id }}-message">
          <span>{{ section.settings.message_label }}</span>
          <textarea id="{{ form_id }}-message" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
        </label>

        <input
          type="hidden"
          name="contact[subject]"
          value="{{ section.settings.subject | escape }}"
          data-rr-subject
          data-default="{{ section.settings.subject | escape }}"
        >

        <button class="rr-enquiry__submit" type="submit">{{ section.settings.button_label }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

<script>
  // "Enquire" buttons link here with ?piece=No.+8001: pre-fill the subject and message.
  (() => {
    const piece = new URLSearchParams(window.location.search).get('piece');
    if (!piece) return;
    const form = document.getElementById({{ form_id | json }});
    if (!form) return;
    const subject = form.querySelector('[data-rr-subject]');
    const message = form.querySelector('textarea');
    if (subject) subject.value = `${subject.dataset.default}: ${piece}`.slice(0, 150);
    if (message && !message.value) message.value = `I would like to enquire about ${piece}.`;
  })();
</script>

{% stylesheet %}
  .rr-enquiry {
    padding: 88px var(--rr-gutter) 120px;
    background: var(--rr-yellow);
    color: var(--rr-ink);
  }

  .rr-enquiry__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 72px;
    max-width: var(--rr-grid-width);
    margin: 0 auto;
  }

  .rr-enquiry__grid--single {
    grid-template-columns: minmax(0, 640px);
    justify-content: center;
  }

  .rr-enquiry__title {
    margin: 0 0 24px;
    font-family: var(--rr-font-serif);
    font-size: clamp(30px, 3vw, 42px);
    font-weight: 400;
    line-height: 1.1;
  }

  .rr-enquiry__details {
    font-family: var(--rr-font-body);
    font-size: 15px;
    line-height: 1.8;
  }

  .rr-enquiry__list {
    display: grid;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rr-enquiry__contact {
    display: inline-flex;
    gap: 14px;
    align-items: center;
    overflow-wrap: anywhere;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .rr-enquiry__contact:hover,
  .rr-enquiry__contact:focus-visible {
    color: var(--rr-red);
  }

  .rr-enquiry__contact:focus-visible {
    outline: 2px solid var(--rr-ink);
    outline-offset: 4px;
  }

  .rr-enquiry__icon {
    flex: none;
  }

  .rr-enquiry a {
    color: inherit;
  }

  .rr-enquiry__form {
    display: grid;
    gap: 22px;
  }

  .rr-enquiry__field {
    display: grid;
    gap: 8px;
    font-family: var(--rr-font-body);
    font-size: 12px;
    font-style: italic;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .rr-enquiry__field input,
  .rr-enquiry__field textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid rgb(28 24 20 / 35%);
    border-radius: 0;
    background: var(--rr-card);
    font: inherit;
    font-style: normal;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--rr-ink);
  }

  .rr-enquiry__field input:focus-visible,
  .rr-enquiry__field textarea:focus-visible {
    outline: 2px solid var(--rr-ink);
    outline-offset: 2px;
  }

  .rr-enquiry__submit {
    justify-self: start;
    padding: 15px 28px;
    border: 0;
    background: var(--rr-ink);
    font-family: var(--rr-font-body);
    font-size: 13px;
    font-style: italic;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rr-card);
    cursor: pointer;
    transition: background 0.3s ease;
  }

  .rr-enquiry__submit:hover {
    background: var(--rr-red);
  }

  .rr-enquiry__submit:focus-visible {
    outline: 2px solid var(--rr-ink);
    outline-offset: 4px;
  }

  .rr-enquiry__notice {
    margin: 0;
    padding: 14px 16px;
    background: var(--rr-card);
    font-family: var(--rr-font-body);
    font-size: 14px;
  }

  .rr-enquiry__notice--error {
    border-inline-start: 3px solid var(--rr-red);
  }

  @media (max-width: 760px) {
    .rr-enquiry {
      padding-block: 56px 80px;
    }

    .rr-enquiry__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Riverrun enquiry form",
  "settings": [
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell us what you are looking for" },
    { "type": "text", "id": "subject", "label": "Email subject", "default": "Website enquiry" },
    { "type": "text", "id": "name_label", "label": "Name label", "default": "Name" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "message_label", "label": "Message label", "default": "Your message" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Send enquiry" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thank you. We will be in touch soon." },
    { "type": "header", "content": "Get in touch (Contact page)" },
    { "type": "text", "id": "details_heading", "label": "Heading", "default": "Get in touch" },
    { "type": "text", "id": "email", "label": "Email address", "info": "Shown with an email icon. Leave empty to hide." },
    { "type": "text", "id": "instagram_handle", "label": "Instagram handle", "info": "For example @riverrun_decor. Shown with an Instagram icon. Leave empty to hide." },
    { "type": "url", "id": "instagram_url", "label": "Instagram link", "info": "Optional. Defaults to instagram.com/ followed by the handle." }
  ],
  "presets": [{ "name": "Riverrun enquiry form" }]
}
{% endschema %}
