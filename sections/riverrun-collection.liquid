{% comment %}
  Section contract.
  "The Collection" block on the logo-yellow ground: heading, one intro line, and a grid of
  Riverrun product cards four across (two on phones) inside a 1182px block with 18px gaps.
  Shows 24 pieces first, then a "Show more" link that adds 24 at a time. The link is a real
  pagination link, so it still works without JavaScript.
  @example
  <!-- templates/index.json: pick the collection holding all pieces -->
{% endcomment %}

{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
-%}

{% render 'riverrun-collection-styles' %}

<section class="rr-collection" id="rr-shop" {{ section.shopify_attributes }}>
  <div class="rr-collection__head">
    {%- if section.settings.heading != blank -%}
      <h2 class="rr-collection__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="rr-collection__intro">{{ section.settings.intro }}</p>
    {%- endif -%}
  </div>

  {%- paginate source.products by 24 -%}
    <rr-show-more class="rr-collection__body">
      <div class="rr-collection__grid" data-rr-grid>
        {%- for product in source.products -%}
          {%- liquid
            assign card_loading = 'lazy'
            if forloop.index <= 4 and paginate.current_page == 1
              assign card_loading = 'eager'
            endif
          -%}
          {% render 'riverrun-product-card',
            product: product,
            loading: card_loading
          %}
        {%- endfor -%}
      </div>

      {%- if paginate.next -%}
        <div class="rr-collection__more" data-rr-more>
          <a class="rr-collection__more-link" href="{{ paginate.next.url }}" data-rr-more-link>
            {{- section.settings.more_label -}}
          </a>
        </div>
      {%- endif -%}
    </rr-show-more>
  {%- endpaginate -%}

</section>

<script src="{{ 'riverrun-show-more.js' | asset_url }}" defer="defer"></script>


{% schema %}
{
  "name": "Riverrun collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show all products."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Collection" },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro line",
      "default": "Original pieces from China, hand picked one at a time."
    },
    { "type": "text", "id": "more_label", "label": "Show more label", "default": "Show more" }
  ],
  "presets": [{ "name": "Riverrun collection" }]
}
{% endschema %}
